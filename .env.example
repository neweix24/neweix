# Copy to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server-only. NEVER prefix with NEXT_PUBLIC_. On Cloudflare set it with:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
NEWEIX_SITE_URL=https://neweix.com
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=

# Cloudflare Turnstile (server-side verification)
TURNSTILE_SECRET_KEY=

# BulkSMSBD OTP delivery
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# Pathao Courier Merchant API
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Set the same long random value in Pathao Developer API > Webhook Integration.
PATHAO_WEBHOOK_SECRET=
PATHAO_BASE_URL=https://api-hermes.pathao.com

# Google / YouTube OAuth (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
